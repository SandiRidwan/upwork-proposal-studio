# Copy this to .env and fill in ONE key. .env is gitignored.
#
# The studio auto-detects whichever key is present and uses it.
# With no key it still works: it prints a ready-to-paste prompt plus an
# editable scaffold, and runs the panel in deterministic mode.

# Google Gemini (OpenAI-compatible endpoint). Get one at aistudio.google.com
GEMINI_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Groq (fast, cheap Llama)
# GROQ_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# Local model via Ollama (no key needed, just run `ollama serve`)
# UPS_PROVIDER=ollama
# UPS_MODEL=llama3.1

# --- optional overrides ---
# UPS_PROVIDER=gemini          # force a provider instead of auto-detect
# UPS_MODEL=gemini-2.5-flash   # override the model
# UPS_LLM_MODE=auto            # auto | provider | prompt
# UPS_BASE_URL=                # custom OpenAI-compatible base url
# UPS_ENV_FILE=                # point at a different .env path
